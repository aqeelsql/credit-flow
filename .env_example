# CreditFlow environment example
# Copy this file to .env and replace every CHANGE_ME / YOUR_* value.
# Keep .env private and never commit real secrets.

# --- Runtime ---
ENVIRONMENT=local
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Public URLs ---
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_LOCAL_AUTH=false
NEXT_PUBLIC_USE_MOCK_AI=false

# --- Infrastructure ---
POSTGRES_DB=creditflow
POSTGRES_USER=creditflow
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://creditflow:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/creditflow
REDIS_URL=redis://redis:6379/0
RABBITMQ_DEFAULT_USER=creditflow
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_URL=amqp://creditflow:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672/
RABBITMQ_EXCHANGE=creditflow.events
MONGODB_URL=mongodb://mongodb:27017/creditflow_scraper

# --- Internal auth and security ---
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN
JWT_ALGORITHM=HS256
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_ISSUER=creditflow-auth
JWT_AUDIENCE=creditflow
AUTH_SUPERADMIN_EMAILS=superadmin@creditflow.ai
AUTH_SECURE_COOKIE=false
AUTH_FRONTEND_BASE_URL=http://localhost:3000

# --- Billing / Stripe test mode ---
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_STARTER=price_CHANGE_ME_STARTER
STRIPE_PRICE_PRO=price_CHANGE_ME_PRO
STRIPE_PRICE_TEAM=price_CHANGE_ME_TEAM
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing?checkout=success
BILLING_CHECKOUT_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled
BILLING_FRONTEND_BASE_URL=http://localhost:3000
BILLING_FREE_CREDITS=0
BILLING_STARTER_CREDITS=4000
BILLING_PRO_CREDITS=25000
BILLING_TEAM_CREDITS=90000

# --- LinkedIn publishing ---
LINKEDIN_CLIENT_ID=CHANGE_ME_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=CHANGE_ME_LINKEDIN_CLIENT_SECRET
LINKEDIN_REDIRECT_URI=http://localhost:8005/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_API_BASE_URL=https://api.linkedin.com
SOCIAL_PUBLISHING_TOKEN_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
SOCIAL_PUBLISHING_MOCK_MODE=false

# --- AI generation and image generation ---
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
AI_GENERATION_QUOTA_BACKEND=usage
AI_GENERATION_TEXT_CREDIT_COST=100
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_BASE_URL=https://image.pollinations.ai/prompt
IMAGE_GENERATION_PROVIDER=pollinations
IMAGE_GENERATION_MODEL=nanobanana-2-lite
IMAGE_GENERATION_WIDTH=1024
IMAGE_GENERATION_HEIGHT=1024

# --- Research scraper ---
SCRAPER_SERPAPI_API_KEY=CHANGE_ME_SERPAPI_API_KEY
SCRAPER_SERPAPI_SEARCH_ENDPOINT=https://serpapi.com/search.json
SCRAPER_SERPAPI_ENGINE=google
SCRAPER_SERPAPI_GL=us
SCRAPER_SERPAPI_HL=en
SCRAPER_SERPAPI_GOOGLE_DOMAIN=google.com
SCRAPER_MONGODB_DATABASE=creditflow_scraper
SCRAPER_MONGODB_COLLECTION=scraped_documents
SCRAPER_RESEARCH_DEFAULT_MAX_SOURCES=5

# --- Email notifications via Gmail SMTP ---
EMAIL_FROM="CreditFlow <YOUR_GMAIL_ADDRESS@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_GMAIL_ADDRESS@gmail.com
SMTP_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD
SMTP_USE_TLS=true
SMTP_USE_SSL=false
NOTIFICATION_SUPPORT_EMAIL=support@creditflow.local
NOTIFICATION_OPS_EMAIL=ops@creditflow.local
NOTIFICATION_SLACK_WEBHOOK_URL=

# --- Gateway webhooks ---
GATEWAY_STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
GATEWAY_LINKEDIN_WEBHOOK_SECRET=
GATEWAY_OPENROUTER_WEBHOOK_SECRET=

# --- Service tuning ---
USAGE_DEFAULT_MONTHLY_TOKEN_QUOTA=100000
USAGE_THRESHOLD_PERCENTAGES=80,100
SCHEDULER_SCAN_INTERVAL_SECONDS=60
SCHEDULER_DUE_BATCH_SIZE=100
CONTENT_MAX_UPLOAD_MB=10
CONTENT_UPLOAD_DIR=content_service/uploads
